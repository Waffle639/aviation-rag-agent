OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
# Direct Postgres connection (session pooler, port 5432).
# Replace <project-ref>, <region> and <password> with your project values.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
NTSB_API_BASE=https://data.ntsb.gov/carol-api

# LangSmith tracing (optional). Batch ingestion disables it automatically
# (tracing_context in ingestion/embedder.py); set LANGSMITH_TRACING=false
# to disable it everywhere else.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# --------- Security & guardrails ---------
# Master switch: enables Prompt Guard injection detection, OpenAI moderation,
# output leak checks, and ingestion chunk scanning.
# Set to false to disable all security checks (useful for debugging).
RAG_SECURITY=true

# Always-on limits (not affected by RAG_SECURITY):
RAG_MAX_QUESTION_CHARS=1000
RAG_MAX_OUTPUT_TOKENS=2000
RAG_MAX_CONTEXT_CHARS=16000

# Prompt Guard model (local, open source, free).
# 86M = best detection, multilingual (ES/EN).  22M = lighter, English-focused.
PROMPT_GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-86M

# HuggingFace token for gated model download.
# 1. Create account at https://huggingface.co
# 2. Accept the Llama license at the model page above
# 3. Generate a read token at https://huggingface.co/settings/tokens
HF_TOKEN=
